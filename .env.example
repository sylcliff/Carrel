# =============================================================================
# Carrel — environment variables
# Copy to .env and fill in your secrets.
# =============================================================================

# ---- Database ----
POSTGRES_USER=carrel
POSTGRES_PASSWORD=carrel_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://carrel:carrel_dev@127.0.0.1:5432/carrel

# ---- OpenAlex (free, no key required; mailto is recommended for the politeness pool) ----
OPENALEX_MAILTO=you@example.com
# Optional but raises rate limits:
# OPENALEX_API_KEY=

# ---- LLM (litellm picks these up; provider names are litellm-native) ----
# Summarization (default)
DEEPSEEK_API_KEY=
SUMMARIZE_MODEL=deepseek/deepseek-chat
# Fallback provider (e.g. Volcano Ark Doubao)
VOLCANO_API_KEY=
FALLBACK_MODEL=volcengine/doubao-pro-32k

# ---- Embedding (Volcano Ark Doubao) ----
EMBEDDING_MODEL=volcengine/doubao-embedding-large-text-240915
EMBEDDING_DIM=2048

# ---- MinerU (PDF→Markdown; optional in M1) ----
MINERU_BASE_URL=http://127.0.0.1:8000
MINERU_PORT=8000

# ---- Server ----
CARREL_HOST=127.0.0.1
CARREL_PORT=8787
# Comma-separated origins for CORS (Vite default is 5173)
CARREL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

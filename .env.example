# =============================================================================
# Carrel — environment variables
# Copy to .env and fill in your secrets.
# =============================================================================

# ---- Database ----
POSTGRES_USER=carrel
POSTGRES_PASSWORD=carrel_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://carrel:carrel_dev@127.0.0.1:5432/carrel

# ---- OpenAlex (free, no key required; mailto is recommended for the politeness pool) ----
OPENALEX_MAILTO=you@example.com
# Optional but raises rate limits:
# OPENALEX_API_KEY=

# ---- Semantic Scholar (free, no key required; key raises rate limit) ----
# Used for "cited by" counts and citation lists.
# S2_API_KEY=

# ---- LLM (litellm picks these up; provider names are litellm-native) ----
# Summarization (default)
DEEPSEEK_API_KEY=
SUMMARIZE_MODEL=deepseek/deepseek-chat
# Fallback provider (e.g. Volcano Ark Doubao)
VOLCANO_API_KEY=
FALLBACK_MODEL=volcengine/doubao-pro-32k

# ---- Embedding (Volcano Ark Doubao) ----
EMBEDDING_MODEL=volcengine/doubao-embedding-large-text-240915
EMBEDDING_DIM=2048

# ---- MinerU (PDF→Markdown; optional in M1) ----
MINERU_BASE_URL=http://127.0.0.1:8000
MINERU_PORT=8000

# ---- Server ----
CARREL_HOST=127.0.0.1
CARREL_PORT=8787
# Comma-separated origins for CORS (Vite default is 5173)
CARREL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Institutional SSH download (optional) ----
# Generic SSH jump host running a paper-download CLI (e.g. scansci-pdf) on an
# institutional/campus IP. Used only as a fallback when a paper has no
# open-access PDF, and for fetching published journal versions of arXiv papers.
# Disabled entirely unless REMOTE_SSH_ENABLED=true. No host is hardcoded.
#REMOTE_SSH_ENABLED=true
#REMOTE_SSH_HOST=your.jump.host.example
#REMOTE_SSH_PORT=22
#REMOTE_SSH_USER=youruser
# Absolute path to a private key (Ed25519 or RSA) on this machine:
#REMOTE_SSH_KEY_PATH=/Users/you/.ssh/id_ed25519
# Optional known_hosts for strict host-key verification (leave unset to AutoAdd):
#REMOTE_SSH_KNOWN_HOSTS_PATH=/Users/you/.ssh/known_hosts
#REMOTE_SSH_CONNECT_TIMEOUT=25
# Working directory on the remote host where PDFs are written:
#REMOTE_WORK_DIR=/home/youruser/scansci_dl
# Remote command. Placeholders: {id} {work_dir} {timeout}. The CLI must print
# "OK: <path>.pdf" on success. Example for a conda-installed scansci-pdf:
#REMOTE_COMMAND_TEMPLATE=source '/home/youruser/miniconda3/etc/profile.d/conda.sh'; conda activate scansci; mkdir -p '{work_dir}'; timeout {timeout} scansci-pdf get '{id}' --output '{work_dir}' --strategy legal_only
#REMOTE_DL_TIMEOUT=240
#REMOTE_RETRIES=3
# arXiv papers younger than this many days are not checked for a journal version:
#REMOTE_JOURNAL_MIN_AGE_DAYS=180
# Re-check the same arXiv paper no more often than this:
#REMOTE_JOURNAL_CHECK_THROTTLE_DAYS=30
